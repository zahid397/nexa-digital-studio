# Node.js 24.22.1 or newer in the 24.x line.
# Use a pooled Neon URL for runtime, a direct URL for migrations.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.ap-southeast-1.aws.neon.tech/nexa?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.ap-southeast-1.aws.neon.tech/nexa?sslmode=require
PAYLOAD_SECRET=replace-with-at-least-32-random-bytes
SITE_URL=http://localhost:3000
# Optional CLI-only admin bootstrap. Never set these in public/browser variables.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# The safe seed requires explicit acknowledgement.
SEED_DEMO=false
