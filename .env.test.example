# Use a NEW Neon branch or separate local PostgreSQL database, never production.
DATABASE_URL=postgresql://user:password@your-qa-endpoint-pooler.ap-southeast-1.aws.neon.tech/nexa?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@your-qa-endpoint.ap-southeast-1.aws.neon.tech/nexa?sslmode=require
PAYLOAD_SECRET=independent-test-secret-of-at-least-32-characters
SITE_URL=http://localhost:3000
INITIAL_ADMIN_EMAIL=admin@nexa.test
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-test-password-of-at-least-16-characters
SEED_DEMO=true
NEXA_TEST_DATABASE=true
# Optional only when raw PostgreSQL TCP is blocked in the development workspace:
NEXA_NEON_WEBSOCKET=false
